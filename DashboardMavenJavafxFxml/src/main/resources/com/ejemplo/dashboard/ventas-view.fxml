<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.dashboard.controller.VentasController"
      style="-fx-padding: 20;">

    <HBox spacing="10" alignment="CENTER_LEFT">

        <Label text="📅 Fecha:"/>

        <DatePicker fx:id="datePicker"/>

        <Label text="📌 Estado:"/>

        <ComboBox fx:id="comboEstado"
                  prefWidth="130"/>

        <Button text="🔍 Filtrar"
                style="-fx-background-color: #3498DB; -fx-text-fill: white;"/>

        <Button text="📊 Exportar"
                style="-fx-background-color: #27AE60; -fx-text-fill: white;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Total: $2,020.49"
               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

    </HBox>


    <TableView fx:id="tablaVentas"
               prefHeight="400">

        <columns>

            <TableColumn fx:id="colIdVenta"
                         text="ID Venta"
                         prefWidth="80"/>

            <TableColumn fx:id="colProducto"
                         text="Producto"
                         prefWidth="150"/>

            <TableColumn fx:id="colMonto"
                         text="Monto"
                         prefWidth="120"/>

            <TableColumn fx:id="colFecha"
                         text="Fecha"
                         prefWidth="120"/>

            <TableColumn fx:id="colEstado"
                         text="Estado"
                         prefWidth="100"/>

        </columns>

    </TableView>

</VBox>