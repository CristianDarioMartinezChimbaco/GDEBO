<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.ejemplo.controller.DashboardController">

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox
                prefWidth="230"
                spacing="12"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="25"
                        right="18"
                        bottom="25"
                        left="18"/>
            </padding>

            <Label
                    text="DON EDGAR"
                    styleClass="logo"/>

            <Label
                    text="Sistema de Inventario"
                    styleClass="subtitle"/>

            <Separator/>

            <Button
                    text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="menu-button"
                    onAction="#mostrarDashboard"/>

            <Button
                    text="Inventario"
                    maxWidth="Infinity"
                    styleClass="menu-button"
                    onAction="#mostrarInventario"/>

            <Button
                    text="Ventas"
                    maxWidth="Infinity"
                    styleClass="menu-button"
                    onAction="#mostrarVentas"/>

            <Button
                    text="Reportes"
                    maxWidth="Infinity"
                    styleClass="menu-button"
                    onAction="#mostrarReportes"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label
                    text="Usuario: Administrador"
                    styleClass="user-label"/>

        </VBox>

    </left>


    <!-- ================= CONTENIDO ================= -->

    <center>

        <VBox
                spacing="20"
                styleClass="content">

            <padding>
                <Insets
                        top="25"
                        right="30"
                        bottom="25"
                        left="30"/>
            </padding>


            <!-- HEADER -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15">

                <VBox
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="Dashboard"
                            styleClass="title"/>

                    <Label
                            text="Resumen general del inventario"
                            styleClass="description"/>

                </VBox>

                <Button
                        text="+ Nuevo producto"
                        styleClass="primary-button"
                        onAction="#nuevoProducto"/>

            </HBox>


            <!-- ================= TARJETAS ================= -->

            <GridPane
                    hgap="15"
                    vgap="15">

                <VBox
                        GridPane.columnIndex="0"
                        styleClass="card">

                    <Label
                            text="Productos"
                            styleClass="card-title"/>

                    <Label
                            fx:id="lblProductos"
                            text="0"
                            styleClass="card-value"/>

                    <Label
                            text="Registrados"
                            styleClass="card-description"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="1"
                        styleClass="card">

                    <Label
                            text="Stock total"
                            styleClass="card-title"/>

                    <Label
                            fx:id="lblStock"
                            text="0"
                            styleClass="card-value"/>

                    <Label
                            text="Unidades"
                            styleClass="card-description"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="2"
                        styleClass="card">

                    <Label
                            text="Ventas"
                            styleClass="card-title"/>

                    <Label
                            fx:id="lblVentas"
                            text="$0"
                            styleClass="card-value"/>

                    <Label
                            text="Este mes"
                            styleClass="card-description"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="3"
                        styleClass="card warning-card">

                    <Label
                            text="Stock bajo"
                            styleClass="card-title"/>

                    <Label
                            fx:id="lblStockBajo"
                            text="0"
                            styleClass="card-value"/>

                    <Label
                            text="Productos"
                            styleClass="card-description"/>

                </VBox>

            </GridPane>


            <!-- ================= TABLA ================= -->

            <VBox
                    spacing="12"
                    VBox.vgrow="ALWAYS">

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10">

                    <Label
                            text="Inventario"
                            styleClass="section-title"/>

                    <TextField
                            fx:id="txtBuscar"
                            promptText="Buscar producto..."
                            HBox.hgrow="ALWAYS"
                            maxWidth="350"/>

                    <ComboBox
                            fx:id="cmbCategoria"
                            promptText="Categoría"
                            prefWidth="150"/>

                </HBox>


                <TableView
                        fx:id="tablaProductos"
                        VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                                fx:id="colCodigo"
                                text="Código"
                                prefWidth="100"/>

                        <TableColumn
                                fx:id="colNombre"
                                text="Producto"
                                prefWidth="220"/>

                        <TableColumn
                                fx:id="colCategoria"
                                text="Categoría"
                                prefWidth="150"/>

                        <TableColumn
                                fx:id="colStock"
                                text="Stock"
                                prefWidth="100"/>

                        <TableColumn
                                fx:id="colPrecio"
                                text="Precio"
                                prefWidth="130"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- ================= GRÁFICAS ================= -->

            <HBox
                    spacing="20"
                    prefHeight="280">

                <VBox
                        spacing="10"
                        HBox.hgrow="ALWAYS"
                        styleClass="chart-card">

                    <Label
                            text="Ventas por categoría"
                            styleClass="section-title"/>

                    <BarChart
                            fx:id="barChart"
                            animated="false"
                            legendVisible="false"
                            VBox.vgrow="ALWAYS">

                        <xAxis>
                            <CategoryAxis/>
                        </xAxis>

                        <yAxis>
                            <NumberAxis/>
                        </yAxis>

                    </BarChart>

                </VBox>


                <VBox
                        spacing="10"
                        prefWidth="350"
                        styleClass="chart-card">

                    <Label
                            text="Distribución del inventario"
                            styleClass="section-title"/>

                    <PieChart
                            fx:id="pieChart"
                            legendVisible="true"
                            VBox.vgrow="ALWAYS"/>

                </VBox>
            </HBox>
            <!-- ================= PROGRESO ================= -->
            <VBox spacing="7">
                <HBox>
                    <Label
                            text="Nivel de inventario"/>
                    <Label
                            fx:id="lblPorcentaje"
                            text="75%"
                            HBox.hgrow="ALWAYS"
                            alignment="CENTER_RIGHT"/>
                </HBox>
                <ProgressBar
                        fx:id="progressInventario"
                        progress="0.75"
                        maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>